:root {
  color-scheme: light dark;
  font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
}

body {
  margin: 0;
  padding: 24px;
  background: var(--body-background, #f4f5f7);
  color: var(--pf-global--Color--100, #151515);
}

.page {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.page__header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16px;
}

.page__header h1 {
  margin: 0 0 4px;
}

.card {
  background: #fff;
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
}

.card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 12px;
}

.card__header h2 {
  margin: 0 0 4px;
}

.card__header-actions {
  display: flex;
  gap: 8px;
}

.card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field input[type="text"],
.field input[type="password"],
.field textarea,
.field select {
  font: inherit;
  padding: 8px;
  border-radius: 4px;
  border: 1px solid #d2d2d2;
}

.field textarea {
  min-height: 92px;
}

.field small {
  color: #6a6e73;
}

.field--inline {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
}

fieldset.field {
  border: 1px solid #d2d2d2;
  border-radius: 6px;
  padding: 12px;
}

legend {
  padding: 0 6px;
  font-weight: 600;
}

.server-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.server-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid #c7c7c7;
  border-radius: 999px;
  padding: 4px 10px;
  background: #f5f5f5;
  font-size: 0.9rem;
}

.server-chip input {
  margin: 0;
}

.server-chip .origin {
  font-size: 0.75rem;
  text-transform: uppercase;
  color: #6a6e73;
}

.btn {
  font: inherit;
  border-radius: 4px;
  border: 1px solid transparent;
  padding: 8px 16px;
  cursor: pointer;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-primary {
  background: #0066cc;
  color: #fff;
}

.btn-secondary {
  border-color: #0066cc;
  color: #0066cc;
  background: transparent;
}

.btn-ghost {
  border-color: transparent;
  background: transparent;
  color: #6a6e73;
}

.log {
  min-height: 160px;
  max-height: 360px;
  overflow-y: auto;
  background: #111827;
  color: #f3f4f6;
  border-radius: 6px;
  padding: 12px;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: 0.9rem;
}

.banner {
  padding: 10px 12px;
  border-radius: 4px;
  font-size: 0.95rem;
}

.banner--info {
  background: #e7f1fb;
  color: #002952;
}

.banner--warn {
  background: #fff4e5;
  color: #8a4b07;
}

.banner--error {
  background: #ffeaea;
  color: #7d1c1c;
}

.muted {
  color: #8a8f99;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
